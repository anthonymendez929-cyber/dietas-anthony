<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Plataforma Nutricional - Anthony Méndez</title>
    <style>
        body { 
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; 
            background-color: #120e0d; 
            margin: 0;
            padding: 0;
            position: relative;
            min-height: 100vh;
        }

        /* LOGO DE FONDO (MARCA DE AGUA GLOBAL) */
        .watermark {
            display: none; 
            position: fixed; 
            top: 50%; 
            left: 50%; 
            transform: translate(-50%, -50%);
            width: 120%; 
            max-width: 700px; 
            opacity: 0.08; 
            pointer-events: none; 
            z-index: 0;
        }

        /* 1. ESTILOS DEL LOGIN */
        .login-container {
            max-width: 350px; margin: 80px auto; background-color: #271f1d;
            padding: 40px 30px; border-radius: 20px; text-align: center;
            box-shadow: 0 10px 30px rgba(0,0,0,0.8); color: #fff;
            position: relative; z-index: 2;
        }
        .logo { width: 120px; height: 120px; border-radius: 50%; margin-bottom: 15px; object-fit: cover; }
        .brand-title { font-size: 24px; margin: 0; font-weight: 800; letter-spacing: 1px; }
        .brand-subtitle { font-size: 13px; color: #c7b28d; margin-top: 5px; margin-bottom: 30px; letter-spacing: 2px; }
        #client-code {
            width: 100%; padding: 15px; border-radius: 10px; border: none; 
            margin-bottom: 20px; font-size: 16px; text-align: center; box-sizing: border-box;
        }
        .btn-ingresar {
            width: 100%; padding: 15px; background-color: #b33928; color: white; border: none;
            border-radius: 10px; font-size: 16px; font-weight: bold; cursor: pointer; transition: 0.3s;
        }
        .btn-ingresar:hover { background-color: #922c1e; }

        /* 2. ESTILOS DE LA DIETA */
        .tracking-container { 
            display: none; max-width: 500px; margin: 0 auto; 
            background: transparent; 
            padding: 20px; position: relative; color: #333; z-index: 2;
        }
        
        .header-card {
            background: white; border-top: 5px solid #b33928; border-radius: 15px;
            padding: 20px; text-align: center; box-shadow: 0 5px 15px rgba(0,0,0,0.05);
            margin-bottom: 20px;
        }
        .header-card h2 { margin: 0; font-size: 22px; font-weight: 900; text-transform: uppercase; }
        .header-card h4 { color: #b33928; margin: 5px 0 15px 0; font-size: 11px; letter-spacing: 1px; text-transform: uppercase; }
        .stats-row { display: flex; justify-content: space-between; border-top: 1px solid #eee; padding-top: 15px; }
        .stat-box { flex: 1; text-align: center; }
        .stat-box span { display: block; font-size: 9px; color: #888; text-transform: uppercase; margin-bottom: 3px;}
        .stat-box strong { display: block; font-size: 14px; color: #b33928; font-weight: 900; }

        .section-title { color: #b33928; font-weight: bold; font-size: 13px; margin-bottom: 12px; letter-spacing: 1px;}
        
        /* Sistema de Pestañas */
        .tabs { display: flex; gap: 8px; overflow-x: auto; padding-bottom: 10px; margin-bottom: 15px;}
        .tab { 
            background: white; color: #b33928; padding: 6px 16px; border-radius: 20px; cursor: pointer;
            font-weight: bold; font-size: 11px; white-space: nowrap; box-shadow: 0 2px 5px rgba(0,0,0,0.05); transition: 0.2s;
        }
        .tab.active { background: #b33928; color: white; }
        .tab.especial { background: #2c3e50; color: white; }
        .tab.especial.active { background: #1a252f; border: 2px solid #b33928; }
        .tabs::-webkit-scrollbar { display: none; }
        
        /* Contenedores de Días */
        .day-content { display: none; }
        .day-content.active { display: block; }

        .meal-card {
            background: white; border-left: 5px solid #b33928; border-radius: 12px;
            padding: 15px 20px; margin-bottom: 12px; box-shadow: 0 4px 10px rgba(0,0,0,0.04);
        }
        
        /* Estilo especial para tarjetas de notas */
        .note-card { border-left-color: #27ae60; }
        .note-card h5 { color: #27ae60; }
        
        .meal-card h5 { color: #b33928; margin: 0 0 8px 0; font-size: 13px; font-weight: 900; text-transform: uppercase;}
        .meal-card p { margin: 0; color: #222; font-size: 13.5px; font-weight: 500; line-height: 1.5;}
        
        .custom-list { margin-top: 10px; margin-bottom: 10px; padding-left: 20px; font-size: 13px; color: #222; font-weight: 500; line-height: 1.5; }
        .custom-list li { margin-bottom: 8px; }

        .report-section { background: white; padding: 15px; border-radius: 12px; margin-top: 30px; box-shadow: 0 4px 10px rgba(0,0,0,0.05);}
        .report-section label { display: block; margin-top: 10px; font-weight: 600; font-size: 13px;}
        .report-section input[type="number"] { width: 100%; padding: 10px; margin-top: 5px; border-radius: 6px; border: 1px solid #ccc; box-sizing: border-box; }
        .btn-enviar { width: 100%; padding: 12px; background-color: #27ae60; color: white; border: none; border-radius: 6px; font-size: 15px; font-weight: bold; cursor: pointer; margin-top: 15px; }
        .btn-enviar:disabled { background-color: #7f8c8d; cursor: not-allowed; }
    </style>
</head>
<body>

<!-- LOGO DE FONDO GIGANTE -->
<img src="logo gym.jpeg" id="bg-watermark" class="watermark" alt="Fondo">

<!-- 1. PANTALLA DE LOGIN -->
<div id="login-screen" class="login-container">
    <img src="logo gym.jpeg" alt="Logo" class="logo">
    <h1 class="brand-title">PERSONAL TRAINER</h1>
    <p class="brand-subtitle">ANTHONY MÉNDEZ</p>
    <input type="text" id="client-code" placeholder="Clave de acceso">
    <button class="btn-ingresar" onclick="iniciarSistema()">INGRESAR AL SISTEMA</button>
</div>

<!-- 2. PANTALLA DE LA DIETA -->
<div id="tracking-screen" class="tracking-container">

    <!-- DATOS DEL CLIENTE -->
    <div class="header-card">
        <h2>ERICKA YANZAGUANO</h2>
        <h4>Plan Nutricional Personalizado</h4>
        <div class="stats-row">
            <div class="stat-box"><span>Peso Act.</span><strong>Por definir</strong></div>
            <div class="stat-box"><span>Meta</span><strong>Por definir</strong></div>
            <div class="stat-box"><span>Grasa</span><strong>Por definir</strong></div>
        </div>
    </div>

    <!-- NOTAS IMPORTANTES SOBRE PORCIONES -->
    <div class="section-title">▶ GUÍA DE PORCIONES (VEGETALES Y GRASAS)</div>
    <div class="meal-card note-card">
        <p>Para mantener un control calórico exacto y estandarizar las porciones en el plan, aquí tienes los gramajes recomendados para los vegetales. Dado que aportan fibra y volumen con pocas calorías, deben ser abundantes:</p>
        
        <ul class="custom-list">
            <li><strong>Hojas verdes (lechuga, espinaca, rúcula):</strong> Al ser ligeras, la porción ideal es de <strong>150g a 200g</strong> por comida (equivale a un bowl lleno).</li>
            <li><strong>Ensaladas mixtas densas (pepino, tomate, cebolla, rábano, zanahoria):</strong> Por su retención de agua y peso físico, la porción es de <strong>150g a 180g</strong> en total de la mezcla.</li>
            <li><strong>Vegetales cocidos (brócoli, coliflor, vainitas):</strong> En las comidas donde dice "1 taza", el peso equivalente exacto es de <strong>120g a 150g</strong>.</li>
        </ul>
        
        <h5 style="color:#b33928; margin-top: 15px; font-size: 12px;">⚠️ Nota sobre los acompañamientos:</h5>
        <p>Estos gramajes corresponden <strong>únicamente</strong> a los vegetales. Los aderezos pautados, como el aceite de oliva (1 cucharada = aprox. 15g) o el aguacate (1/2 mediano = aprox. 50g a 60g), deben pesarse de forma independiente ya que corresponden a las grasas.</p>
    </div>

    <div class="section-title">▶ TU PLAN NUTRICIONAL</div>

    <!-- PESTAÑAS DE NAVEGACIÓN -->
    <div class="tabs">
        <div class="tab active" onclick="cambiarDia('lunes', this)">LUNES</div>
        <div class="tab" onclick="cambiarDia('martes', this)">MARTES</div>
        <div class="tab" onclick="cambiarDia('miercoles', this)">MIÉRCOLES</div>
        <div class="tab" onclick="cambiarDia('jueves', this)">JUEVES</div>
        <div class="tab" onclick="cambiarDia('viernes', this)">VIERNES</div>
        <div class="tab" onclick="cambiarDia('sabado', this)">SÁBADO</div>
        <div class="tab" onclick="cambiarDia('domingo', this)">DOMINGO</div>
        <div class="tab especial" onclick="cambiarDia('alternativas', this)">★ OPCIONES RÁPIDAS</div>
    </div>

    <!-- ==================== LUNES ==================== -->
    <div id="lunes" class="day-content active">
        <div class="meal-card">
            <h5>Desayuno</h5>
            <p>Tazón de avena (preparada con leche de almendras o agua), mezclada con 1 scoop de proteína en polvo (sabor vainilla o chocolate) y 1 taza de fresas.</p>
        </div>
        <div class="meal-card">
            <h5>Almuerzo</h5>
            <p>150g de pechuga de pollo a la plancha (condimentada con finas hierbas, sin salsas fuertes), 120g de arroz integral y 1 taza de brócoli al vapor.</p>
        </div>
        <div class="meal-card">
            <h5>Snack (En el trabajo)</h5>
            <p>1 taza (200g) de yogur griego natural acompañado de 30g de almendras y 1 manzana picada. </p>
        </div>
        <div class="meal-card">
            <h5>Cena</h5>
            <p>150g de lomo de res magro a la parrilla, 1/2 aguacate mediano y una ensalada fresca de pepino y tomate.</p>
        </div>
    </div>

    <!-- ==================== MARTES ==================== -->
    <div id="martes" class="day-content">
        <div class="meal-card">
            <h5>Desayuno</h5>
            <p><strong>Pancakes de avena:</strong> Licuar 60g de avena, 3 claras de huevo, 1 chorrito de leche vegetal y canela. Servir con 1 cucharada de mantequilla de maní.</p>
        </div>
        <div class="meal-card">
            <h5>Almuerzo</h5>
            <p>150g de carne molida de res (magra, 90/10), 150g de papa cocida en cubos y 1 taza de vainitas salteadas.</p>
        </div>
        <div class="meal-card">
            <h5>Snack (En el trabajo)</h5>
            <p><strong>Rollitos de pavo:</strong> 80g de jamón de pechuga de pavo enrollando 40g de queso fresco, más un puñado (20g) de nueces.</p>
        </div>
        <div class="meal-card">
            <h5>Cena</h5>
            <p>150g de pechuga de pollo desmechada, acompañada de 150g de puré de camote  y ensalada verde.</p>
        </div>
    </div>

    <!-- ==================== MIÉRCOLES ==================== -->
    <div id="miercoles" class="day-content">
        <div class="meal-card">
            <h5>Desayuno</h5>
            <p><strong>Batido proteico y energético:</strong> 1 scoop de proteína, 1 plátano mediano, 1 puñado de espinacas frescas y leche de almendras.</p>
        </div>
        <div class="meal-card">
            <h5>Almuerzo</h5>
            <p>150g de pechuga de pavo o pollo al horno, 120g de fideos integrales con salsa de tomate natural (casera) y ensalada de zanahoria rallada.</p>
        </div>
        <div class="meal-card">
            <h5>Snack (En el trabajo)</h5>
            <p>2 tostadas de arroz inflado untadas con 1/2 aguacate machacado y tomates cherry.</p>
        </div>
        <div class="meal-card">
            <h5>Cena</h5>
            <p><strong>Hamburguesa casera de res:</strong> 150g de carne magra (sin pan), servida sobre una cama de lechuga con rodajas de tomate y 1 cucharada de aceite de oliva.</p>
        </div>
    </div>

    <!-- ==================== JUEVES ==================== -->
    <div id="jueves" class="day-content">
        <div class="meal-card">
            <h5>Desayuno</h5>
            <p>Omelette de 3 claras y 1 huevo entero con espinacas y champiñones <em>(preparado en casa, no genera el olor del huevo duro)</em>. 1 rebanada de pan integral.</p>
        </div>
        <div class="meal-card">
            <h5>Almuerzo</h5>
            <p>150g de pollo salteado con pimientos de colores y cebolla, acompañado de 150g de quinua cocida.</p>
        </div>
        <div class="meal-card">
            <h5>Snack </h5>
            <p>1 taza de yogur griego natural con 1 cucharada de semillas de chía y 1/2 taza de arándanos.</p>
        </div>
        <div class="meal-card">
            <h5>Cena</h5>
            <p>150g de carne de res magra en tiras, 150g de plátano verde o maduro asado y ensalada de pepino.</p>
        </div>
    </div>

    <!-- ==================== VIERNES ==================== -->
    <div id="viernes" class="day-content">
        <div class="meal-card">
            <h5>Desayuno</h5>
            <p>2 rebanadas de pan integral tostado, 1/2 aguacate machacado y 60g de queso panela o fresco asado.</p>
        </div>
        <div class="meal-card">
            <h5>Almuerzo</h5>
            <p>150g de pechuga de pollo en cubos, 120g de arroz integral y 120gr taza de choclo.</p>
        </div>
        <div class="meal-card">
            <h5>Snack (En el trabajo)</h5>
            <p>Batido de 1 scoop de proteína en agua o leche de almendras, acompañado de 30g de almendras.</p>
        </div>
        <div class="meal-card">
            <h5>Cena</h5>
            <p>150g de lomo de res a la plancha, 1 taza de coliflor y zanahorias asadas al horno con un chorrito de aceite de oliva.</p>
        </div>
    </div>

    <!-- ==================== SÁBADO ==================== -->
    <div id="sabado" class="day-content">
        <div class="meal-card">
            <h5>Desayuno</h5>
            <p>Avena horneada o cocida (60g) mezclada con 1 manzana en cubos, canela y 1 scoop de proteína.</p>
        </div>
        <div class="meal-card">
            <h5>Almuerzo</h5>
            <p>150g de pechuga de pavo asada, 150g de yuca cocida y ensalada gigante de lechuga, pepino y rabanitos.</p>
        </div>
        <div class="meal-card">
            <h5>Snack de media tarde</h5>
            <p>1 taza de yogur griego con 1 cucharada de crema de almendras o maní.</p>
        </div>
        <div class="meal-card">
            <h5>Cena</h5>
            <p><strong>Fajitas de pollo:</strong> 150g de pollo (sin tortilla), salteadas con vegetales a elección y guacamole casero (1/2 aguacate).</p>
        </div>
    </div>

    <!-- ==================== DOMINGO ==================== -->
    <div id="domingo" class="day-content">
        <div class="meal-card">
            <h5>Desayuno</h5>
            <p>3 huevos revueltos con tomate y cebolla , acompañados de 1 arepa pequeña (60g) o 2 tostadas integrales.</p>
        </div>
        <div class="meal-card">
            <h5>Almuerzo</h5>
            <p>150g de carne de res magra al jugo, 120g de arroz integral y 1 taza de vegetales mixtos cocidos.</p>
        </div>
        <div class="meal-card">
            <h5>Snack de media tarde</h5>
            <p>Gelatina sin azúcar (porción libre) acompañada de 40g de queso fresco en cubos.</p>
        </div>
        <div class="meal-card">
            <h5>Cena</h5>
            <p>150g de pechuga de pollo a la plancha, crema de vegetales (calabacín y zanahoria) sin lácteos pesados.</p>
        </div>
    </div>

    <!-- ==================== ALTERNATIVAS (OPCIONES RÁPIDAS) ==================== -->
    <div id="alternativas" class="day-content">
        <div class="meal-card">
            <h5>Sustituto de Almuerzo/Cena rápido</h5>
            <p>Sándwich de pan integral con doble porción de pechuga de pollo o jamón de pavo, queso fresco bajo en grasa, lechuga y tomate de bolsa listos para comer.</p>
        </div>
        <div class="meal-card">
            <h5>Sustituto de Merienda rápido</h5>
            <p>1 vaso de leche descremada o vegetal + 1 barra de proteína de buena calidad (baja en azúcar, >15g de proteína).</p>
        </div>
        <div class="meal-card">
            <h5>Snack saciante anti-ansiedad</h5>
            <p>Bastones de apio o zanahoria listos para consumir (comprados en el supermercado) con queso cottage.</p>
        </div>
    </div>

    <!-- REPORTE DE HÁBITOS CON EMAIL -->
    <div class="report-section">
        <div class="section-title" style="margin-bottom: 0;">▶ REPORTE DE HÁBITOS</div>
        
        <label>Agua consumida hoy (Litros):</label>
        <input type="number" id="agua" placeholder="Ej. 2.5">
        
        <label>Horas de sueño anoche:</label>
        <input type="number" id="sueno" placeholder="Ej. 7.5">

        <label>Pasos diarios (Cantidad):</label>
        <input type="number" id="pasos" placeholder="Ej. 10000">

        <button class="btn-enviar" id="btnSubmit" onclick="enviarReporte()">Enviar Reporte Diario</button>
    </div>
</div>

<script>
    function iniciarSistema() {
        const inputCodigo = document.getElementById('client-code').value.trim().toUpperCase();
        if (inputCodigo === "") {
            alert("Por favor, ingresa tu clave de acceso.");
            return;
        }
        
        // CÓDIGO DE ACCESO PARA ERICKA YANZAGUANO
        if (inputCodigo === "ERICKAY0826") {
            document.body.style.backgroundColor = "#e8e8e8";
            document.getElementById('login-screen').style.display = 'none';
            document.getElementById('tracking-screen').style.display = 'block';
            document.getElementById('bg-watermark').style.display = 'block';
        } else {
            alert("Código incorrecto. Intenta nuevamente...");
        }
    }

    function cambiarDia(diaId, elementoPestana) {
        const dias = document.querySelectorAll('.day-content');
        dias.forEach(dia => dia.classList.remove('active'));

        const pestanas = document.querySelectorAll('.tab');
        pestanas.forEach(pestana => pestana.classList.remove('active'));

        document.getElementById(diaId).classList.add('active');
        elementoPestana.classList.add('active');
    }

    // ENVÍO DE REPORTE POR CORREO
    function enviarReporte() {
        const agua = document.getElementById('agua').value;
        const sueno = document.getElementById('sueno').value;
        const pasos = document.getElementById('pasos').value;
        const btn = document.getElementById('btnSubmit');

        if(agua === "" || sueno === "" || pasos === "") {
            alert("Por favor, llena todos los campos antes de enviar.");
            return;
        }

        btn.innerText = "Enviando...";
        btn.disabled = true;

        const urlDestino = "https://formsubmit.co/ajax/anthonymendez929@gmail.com";

        fetch(urlDestino, {
            method: "POST",
            headers: { 
                'Content-Type': 'application/json',
                'Accept': 'application/json'
            },
            body: JSON.stringify({
                Paciente: "ERICKA YANZAGUANO", 
                Agua_Litros: agua,
                Horas_Sueno: sueno,
                Pasos_Diarios: pasos,
                Fecha: new Date().toLocaleDateString()
            })
        })
        .then(response => response.json())
        .then(data => {
            alert("¡Reporte enviado exitosamente!");
            document.getElementById('agua').value = "";
            document.getElementById('sueno').value = "";
            document.getElementById('pasos').value = "";
            btn.innerText = "Enviar Reporte Diario";
            btn.disabled = false;
        })
        .catch(error => {
            alert("Hubo un error de conexión. Inténtalo de nuevo.");
            btn.innerText = "Enviar Reporte Diario";
            btn.disabled = false;
        });
    }
</script>

</body>
</html>
